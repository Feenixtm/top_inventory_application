<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/outputStyles.css">
</head>
<body class="p-4">
    <h1 class="mb-4">Inventory</h1>

    <div class="inventory-div">    
        <% data.map((slot, index) => { %>
            <div class="slot-div">
                <% if (slot.itemName !== null) { %>
                    <div class="flex flex-col items-center gap-1">
                        <a class="green-link" href="/edit-slot/<%= slot.slotID %>"><%= slot.slotID %></a>
                        <span><%= slot.amount %> <%= slot.itemName.toLocaleUpperCase() %></span>
                    </div>
                <% } else { %>
                    <div class="flex flex-col items-center gap-1">
                        <a class="red-link" href="/edit-slot/<%= slot.slotID %>"><%= slot.slotID %></a>
                        <span>EMPTY</span>
                    </div>
                <% } %>
            </div>
        <% }) %>
    </div>
</body>
</html>