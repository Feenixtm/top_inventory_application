<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/outputStyles.css">
</head>
<body class="p-4">
    <h1 class="text-[1.5rem] font-semibold mb-4">Inventory</h1>

    <div class="inventory-div">
        <% Array.from({ length: 36 }).map((_, index) => { %>
            <% const relevantSlot = data.find(slot => slot.slotID === (index + 1)) %>

            <div class="slot-div">
                
                <% if (relevantSlot && relevantSlot.itemName !== null) { %>

                    <div class="flex flex-col items-center gap-1">
                        <a class="green-link" href="/edit-slot/<%= relevantSlot.slotID %>"><%= relevantSlot.slotID %></a>
                        <span class="text-[0.75rem]"><%= relevantSlot.amount %> <%= relevantSlot.itemName.toLocaleUpperCase() %></span>
                    </div>
                    
                <% } else { %>

                    <div class="flex flex-col items-center gap-1">
                        <a class="red-link" href="/edit-slot/<%= (index + 1) %>"><%= (index + 1) %></a>
                        <span class="text-[0.75rem]">EMPTY</span>
                    </div>
                
                <% } %>
                 
            </div>
        <% }) %>  
    </div>

</body>
</html>